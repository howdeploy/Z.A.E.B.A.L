{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.zaebal/core/zaebal.py --host claude",
            "timeout": 180
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.zaebal/core/zaebal.py --host claude --guard",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
